@startuml
skinparam componentStyle uml2

node "On-Premises Network" {
    [On-Prem DNS Server] as OnPremDNS
    [Local Client] as Client
}

node "AWS Cloud" {
    [Route 53 Inbound Endpoint] as Inbound
    [Route 53 Resolver] as Resolver
    [Private Hosted Zone (PHZ)] as PHZ
}

Client -down-> OnPremDNS: Query (api.example.internal)
OnPremDNS -down-> Inbound: Forward Query (Conditional Forwarder)
Inbound -down-> Resolver
Resolver -down-> PHZ: Resolve (api.internal)
PHZ -up-> Resolver: IP Address
Resolver -up-> Inbound: IP Address
Inbound -up-> OnPremDNS: Response
OnPremDNS -up-> Client: IP Address

@enduml
